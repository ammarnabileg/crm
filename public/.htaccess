# HaHireAI — Apache front controller.
# Point your site's document root at THIS folder (recommended), then every
# request that isn't a real file is routed to index.php so clean URLs work
# (/install, /login, /dashboard, …).

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Authorization header passthrough (some hosts strip it) — for API tokens.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Serve existing files/directories as-is (assets, etc.).
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else → the single front controller.
    RewriteRule ^ index.php [L]
</IfModule>

# No directory listings.
Options -Indexes

# Never serve dotfiles (e.g. a stray .env).
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
