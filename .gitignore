# Environment & secrets
/.env

# Install lock & transient state
/storage/framework/installed
/storage/framework/install_state.json
/storage/framework/maintenance.json

# Runtime storage (keep the directories, ignore their contents)
/storage/logs/*
/storage/cache/*
/storage/sessions/*
/storage/app/*
/storage/backups/*
# Keep the private sub-trees the app writes to (uploads/exports/imports) so a fresh
# clone/deploy has them — but still ignore the files written into them.
!/storage/app/uploads/
!/storage/app/exports/
!/storage/app/imports/
/storage/app/uploads/*
/storage/app/exports/*
/storage/app/imports/*
!/storage/**/.gitkeep

# Dependencies / build
/node_modules
/vendor

# OS / editor noise
.DS_Store
Thumbs.db
*.log
