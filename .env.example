# HaHireAI — environment configuration (copy to .env; never commit .env)
# See docs/CONFIGURATION_GUIDE.md

APP_NAME="HaHireAI"
APP_ENV=production           # local | testing | production
APP_DEBUG=false             # MUST be false in production
APP_URL=http://localhost
APP_KEY=                    # base64 app key, generated during install
APP_TIMEZONE=UTC
APP_LOCALE=en               # en | ar

# Database (MySQL 8+) — used from Phase 8 onward
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hahireai
DB_USERNAME=root
DB_PASSWORD=

# Logging
LOG_LEVEL=info              # debug | info | warning | error | critical
LOG_CHANNEL=file

# Sessions / security
SESSION_DRIVER=file          # file (built in) | redis | database (future)
SESSION_LIFETIME=120         # server-side validity in minutes (drives gc_maxlifetime)
SESSION_EXPIRE_ON_CLOSE=false # true = cookie cleared when the browser closes
SESSION_COOKIE=hahireai_session
# SESSION_SECURE: auto (default) sets the Secure flag ONLY over HTTPS, so plain
# http/localhost no longer silently drops the login cookie. Use true|false to
# force it (e.g. true when TLS is terminated upstream and not auto-detected).
SESSION_SECURE=auto
SESSION_SAMESITE=Lax         # Lax | Strict | None
SESSION_HTTP_ONLY=true
# SESSION_DOMAIN=            # leave empty for a host-only cookie (recommended)

# Set to true ONLY when the app runs behind a trusted reverse proxy / load
# balancer / Cloudflare that terminates TLS, so X-Forwarded-Proto / CF-Visitor
# are honoured when deciding the request was HTTPS. Never enable on a directly
# exposed server — the headers are client-spoofable.
TRUST_PROXY=false
