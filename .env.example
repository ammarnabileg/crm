# HalaOps environment configuration.
# This file is written automatically by the web installer — you normally do not
# edit it by hand. It is shown here for reference and for advanced deployments.

APP_NAME=HalaOps
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Riyadh
APP_CURRENCY=SAR

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_COOKIE=halaops_session
SESSION_LIFETIME=7200
SESSION_SECURE=false

MAIL_ENABLED=false
MAIL_FROM_ADDRESS=no-reply@halaops.local
MAIL_FROM_NAME=HalaOps
